---
interface Props {
	text: string;
}

const { text } = Astro.props;
let characterIndex = 0;
const words = text.split(' ').map((word) =>
	Array.from(word).map((character) => ({
		character,
		delay: 40 + ((characterIndex++ * 83) % 280),
	})),
);
---

<h1 class="animated-title" aria-label={text}>
	{
		words.map((word, wordIndex) => (
			<>
				{wordIndex > 0 && ' '}
				<span class="animated-title__word" aria-hidden="true">
					{word.map(({ character, delay }) => (
						<span class="animated-title__mask">
							<span class="animated-title__char" style={`--char-delay: ${delay}ms`}>
								{character}
							</span>
						</span>
					))}
				</span>
			</>
		))
	}
</h1>
