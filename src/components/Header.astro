---
import { copy, localizedPath, type Locale } from '../i18n';

interface Props {
	locale: Locale;
	alternatePath: string;
}

const { locale, alternatePath } = Astro.props;
const text = copy[locale];
const currentPath = Astro.url.pathname;
const links = [
	{ label: text.portfolio, href: localizedPath(locale, '/portfolio/') },
	{ label: text.blog, href: localizedPath(locale, '/blog/') },
	{ label: text.cv, href: localizedPath(locale, '/cv/') },
	{ label: text.contact, href: localizedPath(locale, '/contact/') },
];

const isActive = (href: string): boolean =>
	currentPath.startsWith(href);
---

<header class="site-header">
	<div class="header-inner">
		<a class="brand" href={localizedPath(locale)}>{text.siteName}</a>

		<nav class="main-nav" aria-label={text.navigation}>
			{
				links.map(({ label, href }) => (
					<a href={href} aria-current={isActive(href) ? 'page' : undefined}>
						{label}
					</a>
				))
			}
		</nav>

		<div class="header-controls">
			<div class="language-switch" aria-label={text.language}>
				{
					locale === 'fr' ? (
						<>
							<span aria-current="page">FR</span>
							<span aria-hidden="true">/</span>
							<a href={alternatePath} lang="en" hreflang="en">EN</a>
						</>
					) : (
						<>
							<a href={alternatePath} lang="fr" hreflang="fr">FR</a>
							<span aria-hidden="true">/</span>
							<span aria-current="page">EN</span>
						</>
					)
				}
			</div>

			<div class="theme-switch" role="group" aria-label={text.theme}>
				<button type="button" data-theme-value="system" aria-label={text.themeSystem} title={text.themeSystem}>
					<svg viewBox="0 0 24 24" aria-hidden="true">
						<rect x="3" y="4" width="18" height="13" rx="1"></rect>
						<path d="M8 21h8M12 17v4"></path>
					</svg>
				</button>
				<button type="button" data-theme-value="light" aria-label={text.themeLight} title={text.themeLight}>
					<svg viewBox="0 0 24 24" aria-hidden="true">
						<circle cx="12" cy="12" r="4"></circle>
						<path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
					</svg>
				</button>
				<button type="button" data-theme-value="dark" aria-label={text.themeDark} title={text.themeDark}>
					<svg viewBox="0 0 24 24" aria-hidden="true">
						<path d="M20.5 14.3A8.5 8.5 0 1 1 9.7 3.5a7 7 0 0 0 10.8 10.8Z"></path>
					</svg>
				</button>
			</div>
		</div>
	</div>
</header>

<script>
	const themeButtons = document.querySelectorAll('[data-theme-value]');
	const activeTheme = document.documentElement.dataset.theme ?? 'system';

	themeButtons.forEach((button) => {
		if (!(button instanceof HTMLButtonElement)) return;

		button.setAttribute('aria-pressed', String(button.dataset.themeValue === activeTheme));
		button.addEventListener('click', () => {
			const theme = button.dataset.themeValue ?? 'system';
			document.documentElement.dataset.theme = theme;
			themeButtons.forEach((item) =>
				item.setAttribute('aria-pressed', String(item === button)),
			);

			if (theme === 'system') {
				localStorage.removeItem('theme');
			} else {
				localStorage.setItem('theme', theme);
			}
		});
	});
</script>
