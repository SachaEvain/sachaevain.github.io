---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import PurellmCover from '../assets/purellm-cover.svg';

interface Props {
	src: ImageMetadata;
	alt: string;
	class?: string;
	loading?: 'eager' | 'lazy';
	widths?: number[];
	sizes?: string;
}

const { src, alt, class: className } = Astro.props;
---

{src.src === PurellmCover.src ? (
	<PurellmCover class={className} preserveAspectRatio="xMidYMid slice" role="img" aria-label={alt || undefined} aria-hidden={alt ? undefined : 'true'} />
) : (
	<Image {...Astro.props} />
)}
