---
import type { Locale } from '../../../i18n';
import { samplingLogits, samplingProbabilities } from './sampling';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const fr = locale === 'fr';
const probabilities = samplingProbabilities(1, 4);
---

<figure class="sampling" data-sampling>
	<strong>{fr ? 'Des logits aux probabilités de tirage' : 'From logits to sampling probabilities'}</strong>
	<div class="sampling-controls">
		<label for={`temperature-${locale}`}>{fr ? 'Température' : 'Temperature'}: <output data-temperature-value>1.0</output>
			<input id={`temperature-${locale}`} data-temperature type="range" min="0.2" max="2" step="0.1" value="1" />
		</label>
		<label for={`top-k-${locale}`}>Top-k
			<select id={`top-k-${locale}`} data-top-k>{[1, 2, 3, 4].map(k => <option value={k} selected={k === 4}>{k}</option>)}</select>
		</label>
	</div>
	<div class="sampling-bars" aria-live="polite" aria-atomic="true">
		{samplingLogits.map((logit, index) => <div class="sampling-row" data-token={index}>
			<span><strong>{String.fromCharCode(65 + index)}</strong> <small>logit {logit}</small></span>
			<div class="track" aria-hidden="true"><div data-bar style={`width:${100 * probabilities[index]}%`}></div></div>
			<span data-probability>{(100 * probabilities[index]).toFixed(1)}%</span>
		</div>)}
	</div>
	<figcaption>{fr
		? 'Quatre candidats fictifs, logits fixes [1, 3, 0, 2]. La température change la concentration ; top-k retire des candidats puis renormalise les probabilités. B reste le plus probable. À k = 1, il reçoit 100 %. Aucun tirage aléatoire ni modèle ne tourne ici.'
		: 'Four illustrative candidates, fixed logits [1, 3, 0, 2]. Temperature changes concentration; top-k removes candidates and renormalizes probabilities. B stays most likely. At k = 1, it receives 100%. No random sampling or model runs here.'}</figcaption>
</figure>

<script>
	import { samplingProbabilities } from './sampling';
	for (const root of document.querySelectorAll<HTMLElement>('[data-sampling]')) {
		const temperature = root.querySelector<HTMLInputElement>('[data-temperature]')!;
		const topK = root.querySelector<HTMLSelectElement>('[data-top-k]')!;
		const update = (): void => {
			root.querySelector('[data-temperature-value]')!.textContent = Number(temperature.value).toFixed(1);
			const probabilities = samplingProbabilities(Number(temperature.value), Number(topK.value));
			for (const row of root.querySelectorAll<HTMLElement>('[data-token]')) {
				const percent = 100 * probabilities[Number(row.dataset.token)];
				row.querySelector<HTMLElement>('[data-bar]')!.style.width = `${percent}%`;
				row.querySelector('[data-probability]')!.textContent = `${percent.toFixed(1)}%`;
			}
		};
		temperature.addEventListener('input', update);
		topK.addEventListener('change', update);
	}
</script>

<style>
	.sampling { margin: 2rem 0; padding: 1.25rem; border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface); }
	.sampling-controls { display: grid; grid-template-columns: 1fr 5rem; gap: 1rem; align-items: start; margin: 1rem 0; }
	.sampling input, .sampling select { display: block; width: 100%; min-height: 2.75rem; margin: 0; accent-color: var(--accent); }
	.sampling select { background: var(--background); color: var(--text); border: 1px solid var(--border); border-radius: .25rem; padding: .25rem; font: inherit; }
	.sampling-row { display: grid; grid-template-columns: 5rem 1fr 4rem; gap: .5rem; align-items: center; margin: .75rem 0; }
	.sampling-row > :last-child { text-align: right; font-variant-numeric: tabular-nums; }
	.sampling-row small { margin-left: .25rem; }
	.track { height: 1rem; background: var(--border); }
	.track > div { height: 100%; background: var(--accent); }
	figcaption, small { color: var(--muted); font-size: .875rem; }
	figcaption { margin-top: 1rem; }
</style>
