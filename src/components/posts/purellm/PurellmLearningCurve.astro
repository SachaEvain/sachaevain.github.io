---
import type { Locale } from '../../../i18n';
import enLight from './assets/purellm-learning-en-light.png';
import enDark from './assets/purellm-learning-en-dark.png';
import frLight from './assets/purellm-learning-fr-light.png';
import frDark from './assets/purellm-learning-fr-dark.png';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const fr = locale === 'fr';
const light = fr ? frLight : enLight;
const dark = fr ? frDark : enDark;
const alt = fr
	? 'La loss de validation passe de 6,973 au pas 1 à 1,704 au pas 1 000, puis diminue plus lentement jusqu’à 1,066 au pas 10 000.'
	: 'Validation loss falls from 6.973 at step 1 to 1.704 at step 1,000, then declines more slowly to 1.066 at step 10,000.';
---

<figure class="learning-curve">
	<strong>{fr ? 'Loss de validation' : 'Validation loss'}</strong>
	<div class="run">TinyStories · RTX 4070 · bf16</div>
	<img class="light" src={light.src} width={light.width} height={light.height} alt={alt} loading="lazy" decoding="async" />
	<img class="dark" src={dark.src} width={dark.width} height={dark.height} alt={alt} loading="lazy" decoding="async" />
	<figcaption>{fr
		? '41 évaluations sur le même sous-ensemble de validation. Axes linéaires, aucun lissage. Chaque point est une mesure ; une loss plus faible indique une meilleure prédiction du token suivant.'
		: '41 evaluations on the same validation subset. Linear axes, no smoothing. Each dot is a measurement; lower loss means better next-token prediction.'}</figcaption>
</figure>

<style>
	.learning-curve { margin: 2rem 0; padding: 1.25rem; border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface); }
	.run, figcaption { color: var(--muted); font-size: .875rem; }
	.run { margin-top: .25rem; }
	img { width: 100%; height: auto; margin: 1rem 0; }
	.dark { display: none; }
	:global(:root[data-theme='dark']) .light { display: none; }
	:global(:root[data-theme='dark']) .dark { display: block; }
	@media (prefers-color-scheme: dark) {
		:global(:root:not([data-theme])) .light,
		:global(:root[data-theme='system']) .light { display: none; }
		:global(:root:not([data-theme])) .dark,
		:global(:root[data-theme='system']) .dark { display: block; }
	}
</style>
