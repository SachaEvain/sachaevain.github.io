---
import { copy, type Locale } from '../i18n';
import { postPath, type Post } from '../lib/posts';

interface Props {
	posts: Post[];
	locale: Locale;
}

const { posts, locale } = Astro.props;
const text = copy[locale];
const dateLocale = locale === 'fr' ? 'fr-FR' : 'en-GB';
---

<div class="post-list">
	{
		posts.map((post) => (
			<article class="post-row">
				<div class="post-row__meta">
					<time datetime={post.data.publishedAt.toISOString()}>
						{post.data.publishedAt.toLocaleDateString(dateLocale, {
							year: 'numeric',
							month: 'short',
							day: 'numeric',
						})}
					</time>
					<span>{post.data.type === 'case-study' ? text.caseStudy : text.article}</span>
				</div>
				<h3><a href={postPath(post)}>{post.data.title}</a></h3>
				<p>{post.data.description}</p>
				<span class="post-row__time">{post.data.readingMinutes} {text.minutes}</span>
			</article>
		))
	}
</div>
