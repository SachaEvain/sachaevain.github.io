---
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContentWithToc from './ContentWithToc.astro';
import { copy, localizedPath, otherLocale } from '../i18n';
import { getLocalizedProjects, projectPath, type Project } from '../lib/projects';

interface Props {
	project: Project;
}

const { project } = Astro.props;
const locale = project.data.locale;
const text = copy[locale];
const translation = (await getLocalizedProjects(otherLocale(locale))).find(
	(candidate) => candidate.data.translationKey === project.data.translationKey,
);
if (!translation) {
	throw new Error(`Missing translation for project "${project.data.translationKey}".`);
}
const { Content, headings } = await render(project);
---

<BaseLayout
	locale={locale}
	title={project.data.title}
	description={project.data.description}
	alternatePath={projectPath(translation)}
>
	<article class="project-page shell">
		<header>
			<a class="text-link" href={localizedPath(locale, '/portfolio/')}>
				<span aria-hidden="true">←</span> {text.backToPortfolio}
			</a>
			<p class="eyebrow">{project.data.status}</p>
			<h1>{project.data.title}</h1>
			<p class="article-summary">{project.data.description}</p>
			<ul class="tag-list" aria-label={text.tags}>
				{project.data.tags.map((tag) => <li>{tag}</li>)}
			</ul>
			<a class="button" href={project.data.repositoryUrl} target="_blank" rel="noreferrer">
				{text.viewRepository} <span aria-hidden="true">↗</span>
			</a>
		</header>
		<ContentWithToc headings={headings} locale={locale}>
			<Content />
		</ContentWithToc>
	</article>
</BaseLayout>

<style>
	.project-page {
		max-width: var(--shell);
		padding-block: var(--space-7);
	}

	.project-page header {
		max-width: var(--reading);
		margin-inline: auto;
		margin-bottom: var(--space-6);
	}

	.project-page .eyebrow {
		margin-top: var(--space-5);
	}
</style>
