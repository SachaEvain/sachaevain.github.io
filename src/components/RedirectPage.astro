---
interface Props { destination: string; }
const { destination } = Astro.props;
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta http-equiv="refresh" content={`0;url=${destination}`} />
		<link rel="canonical" href={new URL(destination, Astro.site)} />
		<title>Page moved</title>
	</head>
	<body><a href={destination}>Continue to this page</a></body>
</html>
