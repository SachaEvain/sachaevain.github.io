---
import { copy, localizedPath, type Locale } from '../i18n';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const text = copy[locale];
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="shell footer-inner">
		<p>© {currentYear} {text.footer}</p>
		<nav class="footer-links" aria-label={text.contact}>
			<a href={localizedPath(locale, '/contact/')}>{text.contact}</a>
			<a class="footer-icon" href={text.contactLinkedin} aria-label={text.linkedinLabel} title={text.linkedinLabel}>
				<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
					<path d="M20.45 2H3.55C2.69 2 2 2.68 2 3.52v16.96c0 .84.69 1.52 1.55 1.52h16.9c.86 0 1.55-.68 1.55-1.52V3.52c0-.84-.69-1.52-1.55-1.52ZM7.93 18.75H4.98V9.2h2.95v9.55ZM6.46 7.9a1.71 1.71 0 1 1 0-3.42 1.71 1.71 0 0 1 0 3.42Zm12.29 10.85H15.8V14.1c0-1.11-.02-2.54-1.55-2.54-1.55 0-1.79 1.21-1.79 2.46v4.73H9.51V9.2h2.83v1.3h.04c.39-.74 1.36-1.52 2.79-1.52 2.98 0 3.58 1.96 3.58 4.51v5.26Z" />
				</svg>
			</a>
			<a class="footer-icon" href={text.contactGithub} aria-label={text.githubLabel} title={text.githubLabel}>
				<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
					<path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.86c-2.78.6-3.37-1.18-3.37-1.18-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.89 1.53 2.34 1.09 2.91.83.09-.65.35-1.09.64-1.34-2.22-.25-4.56-1.11-4.56-4.94 0-1.09.39-1.99 1.03-2.69-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.03a9.58 9.58 0 0 1 5 0c1.91-1.3 2.75-1.03 2.75-1.03.55 1.38.2 2.4.1 2.65.64.7 1.03 1.6 1.03 2.69 0 3.84-2.34 4.69-4.57 4.94.36.31.68.92.68 1.85v2.75c0 .27.18.58.69.48A10 10 0 0 0 12 2Z" />
				</svg>
			</a>
			<a class="footer-icon" href={`mailto:${text.contactEmail}`} aria-label={text.emailLabel} title={text.emailLabel}>
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true" focusable="false">
					<rect x="3" y="5" width="18" height="14" rx="1" />
					<path d="m3 6 9 7 9-7" />
				</svg>
			</a>
			<a class="footer-icon" href={localizedPath(locale, '/rss.xml')} aria-label={text.rss} title={text.rss}>
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true" focusable="false">
					<circle cx="5" cy="19" r="1" fill="currentColor" />
					<path d="M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16" />
				</svg>
			</a>
		</nav>
	</div>
</footer>

<style>
	.footer-inner {
		padding-block: 1.25rem;
	}

	.footer-links {
		gap: 0.25rem;
		margin-left: auto;
	}

	.footer-links > a:first-child {
		margin-right: 0.75rem;
	}

	.footer-icon {
		display: inline-grid;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		border-radius: 0.25rem;
	}

	.footer-icon:hover {
		background: var(--surface);
		color: var(--accent);
	}

	.footer-icon svg {
		width: 1.25rem;
		height: 1.25rem;
	}
</style>
