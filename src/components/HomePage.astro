---
import BaseLayout from '../layouts/BaseLayout.astro';
import AnimatedTitle from './AnimatedTitle.astro';
import HomeSystemVisual from './HomeSystemVisual.astro';
import PostList from './PostList.astro';
import ProjectCard from './ProjectCard.astro';
import { copy, localizedPath, otherLocale, type Locale } from '../i18n';
import { getLocalizedPosts } from '../lib/posts';
import { getLocalizedProjects } from '../lib/projects';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const text = copy[locale];
const articles = (await getLocalizedPosts(locale)).slice(0, 3);
const projects = (await getLocalizedProjects(locale)).slice(0, 2);
const alternatePath = localizedPath(otherLocale(locale));
---

<BaseLayout
	locale={locale}
	title={text.heroTitle}
	description={text.siteDescription}
	alternatePath={alternatePath}
>
	<section class="hero home-hero">
		<HomeSystemVisual locale={locale} />
		<div class="hero__content shell">
			<p class="eyebrow">{text.heroEyebrow}</p>
			<AnimatedTitle text={text.heroTitle} variant="hero" />
			<p class="hero__intro">{text.heroIntroduction}</p>
			<div class="hero__actions">
				<a class="button" href={localizedPath(locale, '/portfolio/')}>{text.viewPortfolio}</a>
				<a class="button button--secondary" href={localizedPath(locale, '/cv/')}>{text.viewCv}</a>
			</div>
		</div>
	</section>

	<section class="section shell">
		<div class="section-heading">
			<h2>{text.latestArticles}</h2>
			<a class="text-link" href={localizedPath(locale, '/blog/')}>
				{text.allArticles}<span aria-hidden="true"> →</span>
			</a>
		</div>
		<PostList posts={articles} locale={locale} />
	</section>

	<section class="section shell">
		<div class="section-heading">
			<h2>{text.recentProjects}</h2>
			<a class="text-link" href={localizedPath(locale, '/portfolio/')}>
				{text.allProjects}<span aria-hidden="true"> →</span>
			</a>
		</div>
		<div class="portfolio-grid">
			{
				projects.map((project) => (
					<div class="editorial-grid__cell">
						<ProjectCard project={project} locale={locale} />
					</div>
				))
			}
		</div>
	</section>

	<section class="contact-strip shell">
		<h2>{text.contactCta}</h2>
		<a class="button" href={localizedPath(locale, '/contact/')}>{text.contact}</a>
	</section>
</BaseLayout>

<style>
	.home-hero + .section {
		border-top: 0;
	}

	.home-hero {
		position: relative;
		isolation: isolate;
		display: grid;
		grid-template-columns: 1fr;
		place-items: center;
		min-height: min(50rem, 85svh);
		padding-block: clamp(5rem, 10vw, 8rem);
		overflow: hidden;
		text-align: center;
	}

	.home-hero .hero__content {
		position: relative;
		z-index: 1;
		max-width: 58rem;
	}

	.home-hero :global(h1),
	.home-hero .hero__intro {
		margin-inline: auto;
	}

	.home-hero .hero__actions {
		justify-content: center;
	}
</style>
