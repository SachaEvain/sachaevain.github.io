---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContentWithToc from './ContentWithToc.astro';
import { copy, localizedPath, type Locale } from '../i18n';
import {
	getLocalizedPosts,
	getPosts,
	getTranslation,
	postPath,
	type Post,
} from '../lib/posts';

interface Props {
	locale: Locale;
	post: Post;
}

const { locale, post } = Astro.props;
const text = copy[locale];
const posts = await getPosts();
const localizedPosts = await getLocalizedPosts(locale);
const translation = getTranslation(posts, post);
const { Content, headings } = await render(post);
const index = localizedPosts.findIndex((candidate) => candidate.id === post.id);
const newerPost = index > 0 ? localizedPosts[index - 1] : undefined;
const olderPost = index < localizedPosts.length - 1 ? localizedPosts[index + 1] : undefined;
const dateLocale = locale === 'fr' ? 'fr-FR' : 'en-GB';
const publishedAt = post.data.publishedAt.toLocaleDateString(dateLocale, {
	year: 'numeric',
	month: 'long',
	day: 'numeric',
});
const heroCover = post.data.heroCover ?? post.data.cover;
---

<BaseLayout
	locale={locale}
	title={post.data.title}
	description={post.data.description}
	alternatePath={postPath(translation)}
	pageClass="article-page"
	ogType="article"
	publishedAt={post.data.publishedAt}
	updatedAt={post.data.updatedAt}
>
	<article class:list={['article', { 'article--with-cover': heroCover }]}>
		{
			heroCover ? (
				<header class="article-hero">
					<Image
						class="article-hero__image"
						src={heroCover}
						alt=""
						widths={[1024, 1536, 2048]}
						sizes="100vw"
						loading="eager"
					/>
					<div class="article-hero__content shell">
						<div class="article-hero__heading">
							<p class="eyebrow">{post.data.type === 'case-study' ? text.caseStudy : text.article}</p>
							<h1>{post.data.title}</h1>
							<div class="article-meta">
								<time datetime={post.data.publishedAt.toISOString()}>{publishedAt}</time>
								<span>{post.data.readingMinutes} {text.minutes}</span>
							</div>
						</div>
						<div class="article-hero__actions">
							<a class="article-hero__button" href={localizedPath(locale, '/blog/')}>
								<span aria-hidden="true">←</span> {text.backToBlog}
							</a>
							<button
								class="article-hero__button"
								type="button"
								data-share-article
								data-share-copied={text.linkCopied}
							>
								<span data-share-label aria-live="polite">{text.shareArticle}</span>
								<span aria-hidden="true">⧉</span>
							</button>
						</div>
					</div>
				</header>
			) : (
				<header class="article-header shell">
					<p class="eyebrow">{post.data.type === 'case-study' ? text.caseStudy : text.article}</p>
					<h1>{post.data.title}</h1>
					<p class="article-summary">{post.data.description}</p>
					<div class="article-meta">
						<time datetime={post.data.publishedAt.toISOString()}>{publishedAt}</time>
						<span>{post.data.readingMinutes} {text.minutes}</span>
					</div>
					<ul class="tag-list" aria-label={text.tags}>
						{post.data.tags.map((tag) => <li>{tag}</li>)}
					</ul>
				</header>
			)
		}

		<div class:list={['article-body', 'shell', { 'article-body--with-cover': heroCover }]}>
			{
				heroCover && (
					<div class="article-intro">
						<p class="article-summary">{post.data.description}</p>
						<ul class="tag-list" aria-label={text.tags}>
							{post.data.tags.map((tag) => <li>{tag}</li>)}
						</ul>
					</div>
				)
			}

			<ContentWithToc headings={headings} locale={locale}>
				<Content />
			</ContentWithToc>

			<nav class="article-pagination" aria-label={text.blog}>
				{
					olderPost ? (
						<a href={postPath(olderPost)}>
							<span>{text.previousArticle}</span>
							<strong>{olderPost.data.title}</strong>
						</a>
					) : (
						<span />
					)
				}
				{
					newerPost && (
						<a class="article-pagination__next" href={postPath(newerPost)}>
							<span>{text.nextArticle}</span>
							<strong>{newerPost.data.title}</strong>
						</a>
					)
				}
			</nav>
		</div>
	</article>
</BaseLayout>

<script>
	const shareButton = document.querySelector<HTMLButtonElement>('[data-share-article]');

	shareButton?.addEventListener('click', async () => {
		try {
			if (navigator.share) {
				await navigator.share({ title: document.title, url: window.location.href });
				return;
			}

			await navigator.clipboard.writeText(window.location.href);
			const label = shareButton.querySelector('[data-share-label]');
			if (label) label.textContent = shareButton.dataset.shareCopied ?? label.textContent;
		} catch (error) {
			if (!(error instanceof DOMException && error.name === 'AbortError')) throw error;
		}
	});
</script>
