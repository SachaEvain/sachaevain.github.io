				'Ranked 1st out of 204 students in the Master’s year; coursework included machine learning, deep learning, data analysis, algorithms, metaheuristics, Hadoop, and Spark.',
			],
		},
		skills: [
			{
				name: 'Data & ML',
				details:
					'Python, SQL, PyTorch, Keras, scikit-learn, LightGBM, XGBoost, deep learning, feature engineering, model evaluation, hyperparameter optimization, statistical modeling, forecasting, explainable AI, LLM fine-tuning',
			},
			{
				name: 'Data platforms',
				details:
					'Snowflake, Hadoop, Spark, Polars, ETL/ELT, Airflow, Prefect, data quality, data preprocessing, scientific data analysis, data pipeline design',
			},
			{
				name: 'MLOps & infrastructure',
				details:
					'Azure ML, MLflow, Weights & Biases, DVC, Docker, Git, Kubernetes, k3s, GitOps, model deployment, experiment tracking, model registry, reproducible ML, ML pipeline automation, Linux',
			},
			{
				name: 'AI systems',
				details: 'LLMs, RAG, text-to-SQL agents, source-grounded generation',
			},
		],
		projects: [
			'End-to-end design, training, and fine-tuning of LLMs.',
			'HomeLab infrastructure: self-hosted k3s Kubernetes cluster on Proxmox, GitOps deployments, and server administration.',
			'Data competitions: Kaggle and CrunchDAO.',
			'Cybersecurity: Top 500 on Root-Me among approximately 300,000 participants - 7,500 points.',
		],
		languages: [
			{ name: 'English', level: 'C1 - TOEIC 885' },
			{ name: 'French', level: 'Native' },
			{ name: 'Italian', level: 'B1' },
		],
	},
} as const;

const cv = cvByLocale[locale];
---

<BaseLayout
	locale={locale}
	title={text.cvTitle}
	description={text.cvDescription}
	alternatePath={localizedPath(otherLocale(locale), '/cv/')}
	pageClass="cv-page"
>
	<header class="page-header shell cv-header">
		<div>
			<p class="eyebrow">{text.cv}</p>
			<h1>{text.cvTitle}</h1>
			<p class="cv-intro">{text.cvDescription}</p>
			<p class="cv-updated"><time datetime="2026-09">{cv.updated}</time></p>
		</div>
		<a class="button" href={pdfPath} download>{text.downloadCv}</a>
	</header>

	<div class="cv shell">
		<section class="cv-section">
			<h2>{text.cvSummary}</h2>
			<div class="cv-section__content"><p class="cv-summary">{cv.summary}</p></div>
		</section>

		<section class="cv-section">
			<h2>{text.cvExperience}</h2>
			<div class="cv-section__content">
				{
					cv.experience.map((experience) => (
						<article class="cv-entry">
							<header>
								<div>
									<h3>{experience.role}</h3>
									<p>{experience.organization} · {experience.location}</p>
								</div>
								<p class="cv-period">{experience.period}</p>
							</header>
							<ul class="cv-list">
								{experience.highlights.map((highlight) => <li>{highlight}</li>)}
							</ul>
						</article>
					))
				}
			</div>
		</section>

		<section class="cv-section">
			<h2>{text.cvEducation}</h2>
			<div class="cv-section__content">
				<article class="cv-entry">
					<header>
						<div>
							<h3>{cv.education.institution}</h3>
							<p>{cv.education.degree} · {cv.education.location}</p>
						</div>
						<p class="cv-period">{cv.education.period}</p>
					</header>
					<ul class="cv-list">
						{cv.education.highlights.map((highlight) => <li>{highlight}</li>)}
					</ul>
				</article>
			</div>
		</section>

		<section class="cv-section">
			<h2>{text.cvSkills}</h2>
			<div class="cv-section__content">
				<dl class="cv-details">
					{
						cv.skills.map((skill) => (
							<div><dt>{skill.name}</dt><dd>{skill.details}</dd></div>
						))
					}
				</dl>
			</div>
		</section>

		<section class="cv-section">
			<h2>{text.cvProjects}</h2>
			<div class="cv-section__content">
				<ul class="cv-list cv-list--flush">{cv.projects.map((project) => <li>{project}</li>)}</ul>
			</div>
		</section>

		<section class="cv-section">
			<h2>{text.cvLanguages}</h2>
			<div class="cv-section__content">
				<dl class="cv-details cv-details--compact">
					{
						cv.languages.map((language) => (
							<div><dt>{language.name}</dt><dd>{language.level}</dd></div>
						))
					}
				</dl>
			</div>
		</section>
	</div>
</BaseLayout>
