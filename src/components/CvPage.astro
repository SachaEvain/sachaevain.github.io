---
import BaseLayout from '../layouts/BaseLayout.astro';
import { copy, localizedPath, otherLocale, type Locale } from '../i18n';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const text = copy[locale];
const pdfPath = locale === 'fr' ? '/cv/sacha-evain-cv-fr.pdf' : '/cv/sacha-evain-cv-en.pdf';

const cvByLocale = {
