				highlights: [
					'Étude du greenium et analyse des relations entre indicateurs climatiques, données de marché, risque et valorisation d’actifs.',
					'Développement et comparaison de modèles de machine learning et deep learning sur des données financières européennes.',
				],
			},
			{
				role: 'Analyste cybersécurité',
				organization: 'Lenglet-Imprimeurs',
				location: 'Raillencourt, France',
				period: 'Juil. 2022 - août 2022',
				highlights: [
					'Analyse de l’infrastructure réseau industrielle et rédaction d’un plan de continuité d’activité.',
				],
			},
		],
		education: {
			institution: 'Junia ISEN Lille',
			degree: 'Diplôme d’ingénieur en Big Data & Intelligence Artificielle',
			location: 'Lille, France',
			period: '2021 - 2026',
			highlights: [
				'Major de promotion en M2 - 1er sur 204 ; machine learning, deep learning, analyse de données, algorithmes, métaheuristiques, Hadoop et Spark.',
			],
		},
		skills: [
			{
				name: 'Machine learning',
				details:
					'Python, PyTorch, Keras, scikit-learn, LightGBM, XGBoost, deep learning, feature engineering, model evaluation, hyperparameter optimization, statistical modeling, forecasting, explainable AI, LLM fine-tuning, RAG, agents text-to-SQL',
			},
			{
				name: 'Data engineering',
				details:
					'SQL, Snowflake, Hadoop, Spark, Polars, ETL/ELT, Airflow, Prefect, data quality, data preprocessing, scientific data analysis, data pipeline design',
			},
			{
				name: 'MLOps & cloud',
				details:
					'Azure ML, MLflow, Weights & Biases, DVC, Docker, Git, Kubernetes, k3s, GitOps, model deployment, experiment tracking, model registry, reproducible ML, ML pipeline automation, Linux',
			},
			{ name: 'Programmation', details: 'Python, R, Rust, C/C++' },
		],
		projects: [
			'HomeLab / infrastructure : cluster Kubernetes k3s auto-hébergé sur Proxmox, déploiements GitOps et administration de serveurs.',
