---
import type { MarkdownHeading } from 'astro';
import { copy, type Locale } from '../i18n';

interface Props {
	headings: MarkdownHeading[];
	locale: Locale;
}

const { headings, locale } = Astro.props;
const title = copy[locale].tableOfContents;
const sections = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

{
	sections.length > 0 && (
		<details class="toc toc--mobile">
			<summary>{title}</summary>
			<nav aria-label={title}>
				{sections.map((heading) => (
					<a class:list={{ 'toc-depth-3': heading.depth === 3 }} href={`#${heading.slug}`}>
						{heading.text}
					</a>
				))}
			</nav>
		</details>
	)
}

<div class:list={{ 'article-grid': sections.length > 0 }}>
	{
		sections.length > 0 && (
			<aside class="toc toc--desktop">
				<p>{title}</p>
				<nav aria-label={title}>
					{sections.map((heading) => (
						<a class:list={{ 'toc-depth-3': heading.depth === 3 }} href={`#${heading.slug}`}>
							{heading.text}
						</a>
					))}
				</nav>
			</aside>
		)
	}
	<div class="prose">
		<slot />
	</div>
</div>
