---
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE } from '../config';
import { copy, localizedPath, otherLocale, type Locale } from '../i18n';

interface Props {
	locale: Locale;
	title: string;
	description: string;
	alternatePath?: string;
	pageClass?: string;
	ogType?: 'website' | 'article';
	publishedAt?: Date;
	updatedAt?: Date;
}

const {
	locale,
	title,
	description,
	alternatePath,
	pageClass = '',
	ogType = 'website',
	publishedAt,
	updatedAt,
} = Astro.props;
const text = copy[locale];
const currentPath = Astro.url.pathname;
const alternateLocale = otherLocale(locale);
const logicalPath = locale === 'en' ? currentPath.replace(/^\/en(?=\/|$)/, '') || '/' : currentPath;
const resolvedAlternatePath = alternatePath ?? localizedPath(alternateLocale, logicalPath);
const canonicalUrl = new URL(currentPath, Astro.site);
const alternateUrl = new URL(resolvedAlternatePath, Astro.site);
const frUrl = locale === 'fr' ? canonicalUrl : alternateUrl;
const enUrl = locale === 'en' ? canonicalUrl : alternateUrl;
const rssPath = localizedPath(locale, '/rss.xml');
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<script is:inline>
			const savedTheme = localStorage.getItem('theme');
			document.documentElement.dataset.theme =
				savedTheme === 'light' || savedTheme === 'dark' ? savedTheme : 'system';
		</script>
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="robots" content={SITE.ready ? 'index, follow' : 'noindex, nofollow'} />
		<meta property="og:type" content={ogType} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:locale" content={locale === 'fr' ? 'fr_FR' : 'en_GB'} />
		{publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
		{updatedAt && <meta property="article:modified_time" content={updatedAt.toISOString()} />}
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="alternate" hreflang="fr" href={frUrl} />
		<link rel="alternate" hreflang="en" href={enUrl} />
		<link rel="alternate" hreflang="x-default" href={frUrl} />
		<link rel="alternate" type="application/rss+xml" title={text.rss} href={rssPath} />
		<title>{title} · {text.siteName}</title>
	</head>
	<body class={pageClass}>
		<a class="skip-link" href="#main-content">{text.skipToContent}</a>
		<Header locale={locale} alternatePath={resolvedAlternatePath} />
		<main id="main-content">
			<slot />
		</main>
		<Footer locale={locale} />
	</body>
</html>
