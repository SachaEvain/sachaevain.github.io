---
import RedirectPage from '../../../components/RedirectPage.astro';
import type { GetStaticPaths } from 'astro';
import { getLocalizedProjects, projectSlug, projectPath, type Project } from '../../../lib/projects';

export const getStaticPaths = (async () => {
	const projects = await getLocalizedProjects('en');
	return projects.map((project) => ({ params: { slug: projectSlug(project) }, props: { project } }));
}) satisfies GetStaticPaths;

interface Props {
	project: Project;
}

const { project } = Astro.props;
const destination = projectPath(project);
---
<RedirectPage destination={destination} />
